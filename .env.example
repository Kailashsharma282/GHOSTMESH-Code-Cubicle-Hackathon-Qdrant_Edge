# ==============================================================================
# GHOSTMESH PRODUCTION ENVIRONMENT SPECIFICATION (.env.example)
# "Every device remembers alone. Together, they remember everything."
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SYSTEM
# ------------------------------------------------------------------------------
# Application Environment: 'production' | 'development' | 'test'
ENVIRONMENT=production

# Server Network Interface & Port
HOST=0.0.0.0
PORT=8088

# Logging Verbosity: 'INFO' | 'DEBUG' | 'WARNING' | 'ERROR'
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. SECURITY & ACCESS CONTROL
# ------------------------------------------------------------------------------
# Allowed CORS Origins (comma-separated list for production, or '*' for development)
# Example: https://ghostmesh.internal,https://console.ghostmesh.company.com
CORS_ORIGINS=*

# Optional Bearer API Key for administrative control endpoints
# GHOSTMESH_API_KEY=gm_live_sec_9942a1b8e4f

# ------------------------------------------------------------------------------
# 3. CENTRAL RELATIONAL DATABASE (NEON SERVERLESS POSTGRESQL)
# ------------------------------------------------------------------------------
# Connection string from Neon Console (Dashboard -> Connection Details -> Pooled connection)
# Example: postgresql://neondb_owner:npg_secret@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 4. CLOUD VECTOR TIER (QDRANT SERVER / MANAGED CLOUD)
# ------------------------------------------------------------------------------
# URL of central Qdrant Server or Qdrant Cloud cluster
# Local Docker: http://localhost:6333
# Managed Qdrant Cloud: https://xyz-example.eu-central.aws.cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333

# Qdrant Cloud API Key (Required for managed cloud, leave blank for local Docker without auth)
QDRANT_API_KEY=

# Central Memory Collection Name
CLOUD_COLLECTION=ghostmesh_memories

# ------------------------------------------------------------------------------
# 4. EDGE VECTOR TIER (QDRANT EDGE & LOCAL STORAGE)
# ------------------------------------------------------------------------------
# Persistent root directory for edge node shards (WALs, segments, and SQLite metadata)
# Container default: /data or ./data
EDGE_DATA_DIR=./data

# In-Process ONNX Embedding Model (FastEmbed)
# Default: BAAI/bge-small-en-v1.5 (384 dimensions, ~130MB ONNX model)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Optional offline pre-downloaded cache directory for FastEmbed models
# In air-gapped deployments, pre-populate this directory with the ONNX weights.
# FASTEMBED_CACHE_DIR=/root/.cache/fastembed

# ------------------------------------------------------------------------------
# 5. RECONCILIATION & CONSENSUS ENGINE
# ------------------------------------------------------------------------------
# Cosine similarity threshold to identify cross-node conflict candidates (0.0 to 1.0)
RECONCILIATION_THRESHOLD=0.78

# Cosine similarity threshold for automated canonical duplicate merging (0.0 to 1.0)
DUPLICATE_THRESHOLD=0.93

# ------------------------------------------------------------------------------
# 6. FRONTEND CONSOLE CONFIGURATION (Vite Client Build)
# ------------------------------------------------------------------------------
# Base URL for REST API (Leave empty when served from same host via Nginx reverse proxy)
# Example for split CDN/S3 deployment: https://api.ghostmesh.internal
VITE_API_BASE_URL=

# WebSocket live telemetry endpoint
# Example: wss://api.ghostmesh.internal/ws/events
VITE_WS_URL=
