# GhostMesh API Backend Environment (.env.example)
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8088
LOG_LEVEL=INFO
CORS_ORIGINS=*

# Central Neon PostgreSQL Database (From Neon Console)
# Format: postgresql://[user]:[password]@[neon-host]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@YOUR_NEON_HOST.neon.tech/neondb?sslmode=require

# Qdrant Cloud / Server
# For Qdrant Cloud: https://[your-cluster-id].[region].[cloud].cloud.qdrant.io:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
CLOUD_COLLECTION=ghostmesh_memories

# Edge Data Storage (On Render, use /data mounted with a persistent disk)
EDGE_DATA_DIR=./data
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Reconciliation Engine
RECONCILIATION_THRESHOLD=0.78
DUPLICATE_THRESHOLD=0.93
