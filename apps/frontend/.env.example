# GhostMesh Frontend Environment (.env.example)

# Render Backend REST API Base URL
# Replace with your actual Render service URL (e.g. https://ghostmesh-api.onrender.com)
VITE_API_BASE_URL=https://YOUR_RENDER_SERVICE_NAME.onrender.com

# Render Backend WebSocket Live Stream URL
# Replace with your actual Render WebSocket URL (e.g. wss://ghostmesh-api.onrender.com/ws/events)
VITE_WS_URL=wss://YOUR_RENDER_SERVICE_NAME.onrender.com/ws/events
